# Copy to .env (used by docker compose). Never commit the real file.

# Signs login sessions. Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Optional: create these logins on startup if they don't exist yet (user:password,user:password)
SEED_USERS=

# Largest upload in MB (STL files can be big)
MAX_UPLOAD_MB=200

# Timezone used to display times
APP_TIMEZONE=America/New_York

# Optional: Spoolman address, used to offer filament colors when queueing,
# e.g. http://192.168.1.20:7912. Can also be set on the Settings page.
SPOOLMAN_URL=

# Optional: only offer spools stored in this Spoolman location. Empty = any location.
SPOOLMAN_LOCATION=

# Optional: spools with less than this many grams left are marked "low" (Settings page can override)
LOW_SPOOL_GRAMS=100
