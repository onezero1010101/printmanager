# Copy to .env (used by docker compose). Never commit the real file.

# Signs login sessions. Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Optional: create these logins on startup if they don't exist yet (user:password,user:password)
SEED_USERS=

# Timezone used to display times
APP_TIMEZONE=America/New_York
